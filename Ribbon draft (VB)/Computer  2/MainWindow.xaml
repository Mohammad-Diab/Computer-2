<ribbon:RibbonWindow x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        Title="MainWindow" 
        x:Name="RibbonWindow" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Height="600" Width="800">

    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="13" SharedSizeGroup="A" Width="15" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ribbon:Ribbon x:Name="Ribbon" FlowDirection="RightToLeft" Margin="0,0,-763,0">
            <ribbon:Ribbon.ApplicationMenu>
                <ribbon:RibbonApplicationMenu SmallImageSource="Images\SmallIcon.png" FlowDirection="RightToLeft">
                    <ribbon:RibbonApplicationMenuItem Header="جديد"
                                                      x:Name="MenuItem1"
                                                      ImageSource="Images\LargeIcon.png"/>
                    <ribbon:RibbonApplicationMenuItem Header="حفظ"
                                                      x:Name="MenuItem2"
                                                      ImageSource="Images\LargeIcon.png"/>
                    <ribbon:RibbonApplicationMenuItem Header="طباعة"
                                                      x:Name="MenuItem3"
                                                      ImageSource="Images\LargeIcon.png"/>
                    <ribbon:RibbonApplicationMenuItem Header="تعليمات"
                                                      x:Name="MenuItem4"
                                                      ImageSource="Images\LargeIcon.png"/>
                    <ribbon:RibbonApplicationMenuItem Header="حول البرنامج"
                                                      x:Name="MenuItem5"
                                                      ImageSource="Images\LargeIcon.png"/>
                    <ribbon:RibbonApplicationMenuItem Header="انهاء"
                                                      x:Name="MenuItem6"
                                                      ImageSource="Images\LargeIcon.png"/>
                </ribbon:RibbonApplicationMenu>
            </ribbon:Ribbon.ApplicationMenu>
            <ribbon:RibbonTab x:Name="HomeTab"
                              Header="الصفحة الرئيسية">
                <ribbon:RibbonGroup x:Name="Desktop"
                                    Header="حاسب مكتبي">
                    <ribbon:RibbonButton x:Name="Button1"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="PC" />

                    <ribbon:RibbonButton x:Name="Button2"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="MAC" />
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup x:Name="Laptop"
                Header="حاسب محمول">
                <ribbon:RibbonButton x:Name="Button3"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="PC" />

                <ribbon:RibbonButton x:Name="Button4"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="MAC" />
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup x:Name="Tablet"
                                    Header="">
                    <ribbon:RibbonButton x:Name="Button5"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="حاسب لوحي" />

                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup x:Name="Accessories"
                                    Header="">
                    <ribbon:RibbonButton x:Name="Button6"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="اختيار قطع" />

                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup x:Name="Wisard"
                                    Header="">
                    <ribbon:RibbonButton x:Name="Button7"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="اختيار جهاز باستخدام المعالج" />
                </ribbon:RibbonGroup> 
            </ribbon:RibbonTab>
            <ribbon:RibbonTab x:Name="HelpTab"
                              Header="مساعدة">
                <ribbon:RibbonGroup x:Name="Help"
                                    Header="تعليمات">
                    <ribbon:RibbonButton x:Name="Button8"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="تعليمات الاستخدام" />
                    <ribbon:RibbonButton x:Name="Button9"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="مواصفات القطع" />
                    <ribbon:RibbonButton x:Name="Button10"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="مساعدة في اختيارالحاسب" />
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup x:Name="About"
                                    Header="">
                    <ribbon:RibbonButton x:Name="Button11"
                                         LargeImageSource="Images\LargeIcon.png"
                                         Label="عن البرنامج" />
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>
        </ribbon:Ribbon>
        <WindowsFormsHost Grid.Row="1" Height="176" HorizontalAlignment="Left" Margin="214,102,0,0" Name="WindowsFormsHost1" VerticalAlignment="Top" Width="340" />
    </Grid>
</ribbon:RibbonWindow>
