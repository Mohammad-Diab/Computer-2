<common:LayoutAwarePage
    x:Name="pageRoot"
    x:Class="Computer_2.SearchPage"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Computer_2"
    xmlns:common="using:Computer_2.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Loaded="pageRoot_Loaded">

    <Page.Resources>

        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">My Application</x:String>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid Style="{StaticResource LayoutRootStyle}">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF373737"/>
                <GradientStop Color="#FFC8C8C8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <GridView x:Name="SearchResultGridView" SelectionChanged="SearchResultGridView_SelectionChanged" Grid.Row="1" Margin="0,0,400,0" BorderBrush="White" Foreground="White" FontSize="16"/>
        <ListView x:Name="SearchResultListView" HorizontalAlignment="Left" Height="628" Grid.Row="1" VerticalAlignment="Top" Width="320" FontSize="14" Visibility="Collapsed" Foreground="White" SelectionChanged="SearchResultListView_SelectionChanged"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Click="GoBack" IsEnabled="{Binding Frame.CanGoBack, ElementName=pageRoot}" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="pageTitle" Grid.Column="1" Text="Search Result" Style="{StaticResource PageHeaderTextStyle}"/>
        </Grid>
        <TextBlock x:Name="NoResultTextBlock" HorizontalAlignment="Left" Margin="100,25,0,0" TextWrapping="Wrap" Text="No device match your search." VerticalAlignment="Top" FontSize="30" Grid.Row="1" Visibility="Collapsed"/>
        <ScrollViewer x:Name="SearchRefine" HorizontalAlignment="Right" Grid.RowSpan="2" ZoomMode="Disabled" VerticalScrollBarVisibility="Auto" FontSize="20">
            <Grid x:Name="SearchRefineGrid" HorizontalAlignment="Left" Height="768" VerticalAlignment="Top" Width="400" Background="Black" >
                <TextBlock x:Name="SearchTitle" Margin="0,30,0,0" VerticalAlignment="Top" FontSize="28" TextAlignment="Center"/>
                <TextBlock x:Name="SP1TextBlock" Margin="10,85,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <ComboBox x:Name="SP1ComboBox" Margin="0,80,20,0" Width="200" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SP2TextBlock" Margin="10,135,10,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <ComboBox x:Name="SP2ComboBox" Margin="0,130,20,0" Width="200" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SP3TextBlock" Margin="10,185,10,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <ComboBox x:Name="SP3ComboBox" Margin="0,180,20,0" Width="200" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SP4TextBlock" Margin="10,235,10,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <ComboBox x:Name="SP4ComboBox" Margin="0,230,20,0" Width="200" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SP5TextBlock" Margin="10,285,10,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <ComboBox x:Name="SP5ComboBox" Margin="0,280,20,0" Width="200" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SP6TextBlock" Margin="10,335,10,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <ComboBox x:Name="SP6ComboBox" Margin="0,330,20,0" Width="200" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                <ToggleSwitch x:Name="SP7" Margin="4,380,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" OffContent="Don't Care" OnContent="Yes" FontSize="20"/>
                <ToggleSwitch x:Name="SP8" Margin="4,480,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" OffContent="Don't Care" OnContent="Yes" FontSize="20"/>
                <ToggleSwitch x:Name="SP9" Margin="4,580,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" OffContent="Don't Care" OnContent="Yes" FontSize="20"/>
                <Button x:Name="SearchButton" Content="Search" Margin="20,680,20,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" FontSize="20" Click="SearchButton_Click"/>
            </Grid>
        </ScrollViewer>
        <Button x:Name="ExpandButton" HorizontalAlignment="Right" Margin="0,0,410,16" Grid.Row="1" VerticalAlignment="Bottom" Style="{StaticResource TextButtonStyle}" Click="ExpandButton_Click" Foreground="Black"/>
        <Grid x:Name="ResultViewer" Grid.RowSpan="2" Visibility="Collapsed">
            <Rectangle Fill="#66000000" Stroke="Black"/>
            <Grid Margin="100">
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF0A0A0A" Offset="1"/>
                        <GradientStop Color="#FF5F5F5F" Offset="0.004"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <FlipView x:Name="FlipViewResult" FontSize="24"/>
                <Button x:Name="SaveFileButton" Content="Save File" HorizontalAlignment="Right" Margin="0,508,225,10" VerticalAlignment="Stretch" Width="166" FontSize="20" Click="SaveFileButton_Click"/>
                <Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Right" Height="50" Margin="0,0,25,10" VerticalAlignment="Bottom" FontSize="20" Width="166" Click="CloseButton_Click"/>
            </Grid>
        </Grid>
        <Grid x:Name="NoResultGrid" Grid.RowSpan="2" Visibility="Collapsed">
            <Rectangle Fill="#66000000"/>
            <StackPanel x:Name="NoResultStackPanel" Margin="0,315,0,0" VerticalAlignment="Top" Background="#FF232323">
                <TextBlock x:Name="NoResultTitle" FontSize="36" Margin="100,10,400,0" Text="(❕) NO Results Found" VerticalAlignment="Top" TextAlignment="Center"/>
                <TextBlock x:Name="NoResultContent"  TextWrapping="Wrap" Text="Try to reduce some specifications and research again." VerticalAlignment="Top" FontSize="20" TextAlignment="Center"/>
                <Button x:Name="OKButton" Content="OK" HorizontalAlignment="Left" Margin="900,10,0,10" VerticalAlignment="Bottom" Click="OKButton_Click" Width="125"/>
            </StackPanel>
        </Grid>
        
        <VisualStateManager.VisualStateGroups>
            <!-- Visual states reflect the application's view state -->
            <VisualStateGroup x:Name="ApplicationViewStates">
                <VisualState x:Name="FullScreenLandscape"/>
                <VisualState x:Name="Filled"/>

                <!-- The entire page respects the narrower 100-pixel margin convention for portrait -->
                <VisualState x:Name="FullScreenPortrait">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PortraitBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- The back button and title have different styles when snapped -->
                <VisualState x:Name="Snapped">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pageTitle" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedPageHeaderTextStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</common:LayoutAwarePage>
