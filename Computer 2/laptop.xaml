<common:LayoutAwarePage
    x:Name="pageRoot"
    x:Class="Computer_2.laptop"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Computer_2"
    xmlns:common="using:Computer_2.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Loaded="pageRoot_Loaded" FontSize="24">

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid Style="{StaticResource LayoutRootStyle}" >
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF373737"/>
                <GradientStop Color="#FFC8C8C8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Click="GoBack" IsEnabled="{Binding Frame.CanGoBack, ElementName=pageRoot}" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="pageTitle" Grid.Column="1" Text="Choose Your Laptop" Style="{StaticResource PageHeaderTextStyle}" Foreground="#FFDC562E"/>
        </Grid>
        <Grid RenderTransformOrigin="0,0" Grid.Row="1">
            <ListView x:Name="ListView1" Margin="0,65,0,0" SelectionChanged="ListView1_SelectionChanged" HorizontalAlignment="Left" Width="455" FontSize="24"/>
            <ComboBox x:Name="ComboBox1" Margin="192,10,0,0" VerticalAlignment="Top" SelectionChanged="ComboBox1_SelectionChanged" HorizontalAlignment="Left" Width="263"/>
            <TextBlock x:Name="TextBlock0" Margin="10,10,0,0" Text="Company:" VerticalAlignment="Top" FontSize="28" HorizontalAlignment="Left" Foreground="#FFDC562E"/>
            <ScrollViewer x:Name="ScrollViewer1" Margin="475,0,0,0" FontSize="24" HorizontalAlignment="Left" Width="890">
                <Grid>
                    <TextBlock x:Name="TextBlock1" Text="Processor:" VerticalAlignment="Top" Margin="10,10,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock2" Text="Memory:" VerticalAlignment="Top" Margin="10,60,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock3" Text="Hard Disk:" VerticalAlignment="Top" Margin="10,110,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock4" Text="Graphic Card:" VerticalAlignment="Top" Margin="10,160,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock5" Text="Screen:" VerticalAlignment="Top" Margin="10,210,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock6" Text="OS: " VerticalAlignment="Top" Margin="10,260,0,0" HorizontalAlignment="Left"/>
                    <ToggleSwitch x:Name="ToggleSwitch1" Header="Optical Driver" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="4,310,0,0"/>
                    <ToggleSwitch x:Name="ToggleSwitch2" Header="HDMI Port" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="4,410,0,0"/>
                    <ToggleSwitch x:Name="ToggleSwitch3" Header="Touch Screen" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="4,510,0,0"/>
                    <TextBlock Text="Picture" IsHitTestVisible="False" VerticalAlignment="Top" Margin="10,610,10,0" TextAlignment="Center" />
                    <Image Source="" Width="250" Height="250" Margin="308,660,308,0" VerticalAlignment="Top"/>
                </Grid>
            </ScrollViewer>
            <ScrollViewer x:Name="ScrollViewer2" FontSize="24" Margin="320,0,0,0" HorizontalAlignment="Left" Width="320" Visibility="Collapsed">
                <Grid x:Name="Grid">
                    <TextBlock x:Name="TextBlock01" FontSize="20" TextAlignment="Center" Text="Motherboard and Processor" Margin="0,10,0,0" VerticalAlignment="Top" Foreground="#FFDC562E"/>
                    <ComboBox x:Name="ComboBox2" Margin="0,75,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_2" HorizontalAlignment="Left" Margin="10,50,0,0" Text="Chipset:" VerticalAlignment="Top" />
                    <ComboBox x:Name="ComboBox3" Margin="0,150,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_3" HorizontalAlignment="Left" Margin="10,125,0,0" Text="CPU Model:" VerticalAlignment="Top" />
                    <ComboBox x:Name="ComboBox4" Margin="0,215,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_4" HorizontalAlignment="Left" Margin="10,190,0,0" Text="Processor:" VerticalAlignment="Top" />
                    <TextBlock x:Name="TextBlock02" FontSize="20" TextAlignment="Center" Text="Random Access Memory (RAM)" Margin="0,265,0,0" VerticalAlignment="Top" Foreground="#FFDC562E"/>
                    <ComboBox x:Name="ComboBox5" Margin="0,330,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_5" HorizontalAlignment="Left" Margin="10,305,0,0" Text="Size:" VerticalAlignment="Top" />
                    <TextBlock x:Name="TextBlock03" FontSize="20" TextAlignment="Center" Text="Storage Device" Margin="0,380,0,0" VerticalAlignment="Top" Foreground="#FFDC562E"/>
                    <ComboBox x:Name="ComboBox6" Margin="0,445,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_6" HorizontalAlignment="Left" Margin="10,420,0,0" VerticalAlignment="Top"  Text="Type:"/>
                    <ComboBox x:Name="ComboBox7" Margin="0,510,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_7" HorizontalAlignment="Left" Margin="10,485,0,0" VerticalAlignment="Top"  Text="Model:"/>
                    <TextBlock x:Name="TextBlock04" FontSize="20" TextAlignment="Center" Text="Graphic Card" Margin="0,560,0,0" VerticalAlignment="Top" Foreground="#FFDC562E"/>
                    <ComboBox x:Name="ComboBox8" Margin="0,625,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_8" HorizontalAlignment="Left" Margin="10,600,0,0" VerticalAlignment="Top" Text="Type:"/>
                    <ComboBox x:Name="ComboBox9" Margin="0,690,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_9" HorizontalAlignment="Left" Margin="10,665,0,0" VerticalAlignment="Top" Text="Model:"/>
                    <Rectangle x:Name="Rectangle1" Fill="#FFDC562E" Height="2" Margin="40,740,40,0" VerticalAlignment="Top"/>
                    <ComboBox x:Name="ComboBox10" Margin="0,785,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_10" HorizontalAlignment="Left" Margin="10,760,0,0" VerticalAlignment="Top"  Text="Battary:"/>
                    <ComboBox x:Name="ComboBox11" Margin="0,850,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_11" HorizontalAlignment="Left" Margin="10,825,0,0" VerticalAlignment="Top"  Text="Optical Drive:"/>
                    <ComboBox x:Name="ComboBox12" Margin="0,915,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="200"/>
                    <TextBlock x:Name="TextBlock_12" HorizontalAlignment="Left" Margin="10,890,0,0" VerticalAlignment="Top"  Text="Monitor:"/>
                    <Button x:Name="Button3" Content="Done" Click="Button1_Click" HorizontalAlignment="Stretch" Margin="40,970,40,0" VerticalAlignment="Top" BorderBrush="#FFDC562E"/>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Page Grid.Row="1" Width="0" Height="0">
            <Page.BottomAppBar>
                <AppBar Grid.Row="1" Padding="10,0,10,0" Height="90" VerticalAlignment="Bottom">
                    <GridView Margin="0,0,0,0" IsItemClickEnabled="True" Height="90" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="90">
                            <Button x:Name="Button1"  HorizontalAlignment="Left" VerticalAlignment="Top"  Click="Button1_Click" Style="{StaticResource SaveAppBarButtonStyle}" Height="90" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="90">
                            <Button x:Name="Button2"  HorizontalAlignment="Left" VerticalAlignment="Top"  Click="Button2_Click" Style="{StaticResource SearchAppBarButtonStyle}" Height="90" />
                        </StackPanel>
                    </GridView>
                </AppBar>
            </Page.BottomAppBar>
        </Page>
        <VisualStateManager.VisualStateGroups>

            <!-- Visual states reflect the application's view state -->
            <VisualStateGroup x:Name="ApplicationViewStates">
                <VisualState x:Name="FullScreenLandscape"/>
                <VisualState x:Name="Filled"/>

                <!-- The entire page respects the narrower 100-pixel margin convention for portrait -->
                <VisualState x:Name="FullScreenPortrait">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PortraitBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- The back button and title have different styles when snapped -->
                <VisualState x:Name="Snapped">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pageTitle" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedPageHeaderTextStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</common:LayoutAwarePage>