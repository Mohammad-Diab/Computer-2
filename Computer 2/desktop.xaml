<common:LayoutAwarePage
    x:Name="pageRoot"
    x:Class="Computer_2.desktop"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Computer_2"
    xmlns:common="using:Computer_2.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Loaded="pageRoot_Loaded" Width="1366" FontFamily="Calibri (Body)">

    <Page.Resources>

        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">My Application</x:String>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid Style="{StaticResource LayoutRootStyle}">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF373737"/>
                <GradientStop Color="#FFC8C8C8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->

        

        <!-- Back button and page title -->

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Click="GoBack" IsEnabled="{Binding Frame.CanGoBack, ElementName=pageRoot}" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="pageTitle" Grid.Column="1" Text="Select Your PC Pieces" Style="{StaticResource PageHeaderTextStyle}" Foreground="#FF00E5FF"/>
        </Grid>

        <ScrollViewer x:Name="ScrollViewer2" Grid.Row="1" IsHitTestVisible="False" Margin="475,0,0,0" HorizontalAlignment="Left" FontSize="24" Width="885">
            <Grid>
                <TextBlock x:Name="TextBlock1" HorizontalAlignment="Left" Height="Auto" Text="Processor:" VerticalAlignment="Top" Margin="10,10,0,0"/>
                <Grid HorizontalAlignment="Left" Height="90" VerticalAlignment="Top" Width="500" Margin="0,60,0,0">
                    <ToggleSwitch x:Name="ToggleSwitch3" Header="Can Increase CPU Speed (not Over Clocking)" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="0,0,0,0" FontSize="24"/>
                    <TextBlock x:Name="TextBlock6" HorizontalAlignment="Left" Margin="170,51,0,0" Text="Up To:" VerticalAlignment="Top"/>
                </Grid>
                <ToggleSwitch x:Name="ToggleSwitch2" Header="Virtualization Technology" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="0,160,0,0" FontSize="24"/>
                <TextBlock x:Name="TextBlock2" HorizontalAlignment="Left" Text="MotherBoard:" VerticalAlignment="Top" Margin="10,260,0,0"/>
                <TextBlock x:Name="TextBlock3" HorizontalAlignment="Left" Text="Graphic Card:" VerticalAlignment="Top" Margin="10,310,0,0"/>
                <ToggleSwitch x:Name="ToggleSwitch1" Header="Can Add More GPU (CrossFireX or SLI)" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="0,360,0,0" FontSize="24"/>
                <TextBlock x:Name="TextBlock5" HorizontalAlignment="Left" Text="Hard Disk:" VerticalAlignment="Top" Margin="10,460,0,0"/>
                <TextBlock x:Name="TextBlock4" HorizontalAlignment="Left" Text="Memory:" VerticalAlignment="Top" Margin="10,510,0,0"/>
            </Grid>
        </ScrollViewer>
        <ScrollViewer x:Name="ScrollViewer1" HorizontalAlignment="Left" Grid.Row="1" FontSize="24">
            <Grid x:Name="Grid1" Width="475">
                <Image x:Name="Image1" Source="Assets/Andy_plants_pebbles_and_flowers.png" Stretch="None" Opacity="0.33"/>
                <TextBlock x:Name="TextBlock01" FontSize="28" TextAlignment="Center" Text="Motherboard and Processor" Margin="0,10,0,0" VerticalAlignment="Top" Foreground="#FF00E5FF"/>
                <ComboBox x:Name="ComboBox1" Margin="0,60,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox1_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263">
                    <ComboBoxItem Content="AMD"/>
                    <ComboBoxItem Content="Intel"/>
                </ComboBox>
                <TextBlock x:Name="TextBlock_1" HorizontalAlignment="Left" Height="Auto" Margin="10,63,0,0" TextWrapping="Wrap" Text="PC Kind:" VerticalAlignment="Top"/>
                <ComboBox x:Name="ComboBox2" Margin="0,110,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox2_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_2" HorizontalAlignment="Left" Height="Auto" Margin="10,113,0,0" TextWrapping="Wrap" Text="MB Company:" VerticalAlignment="Top" />
                <ComboBox x:Name="ComboBox3" Margin="0,160,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox3_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_3" HorizontalAlignment="Left" Height="Auto" Margin="10,163,0,0" TextWrapping="Wrap" Text="Motherboard:" VerticalAlignment="Top" />
                <ComboBox x:Name="ComboBox4" Margin="0,210,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox4_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_4" HorizontalAlignment="Left" Height="Auto" Margin="10,213,0,0" TextWrapping="Wrap" Text="CPU Model:" VerticalAlignment="Top"  />
                <ComboBox x:Name="ComboBox5" Margin="0,260,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox5_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_5" HorizontalAlignment="Left" Height="Auto" Margin="10,263,0,0" TextWrapping="Wrap" Text="Processor:" VerticalAlignment="Top" />
                <TextBlock x:Name="TextBlock02" FontSize="28" TextAlignment="Center" Text="Random Access Memory (RAM)" Margin="0,310,0,0" VerticalAlignment="Top" Foreground="#FF00E5FF"/>
                <ComboBox x:Name="ComboBox6" Margin="0,360,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox6_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263">
                    <ComboBox.Projection>
                        <PlaneProjection/>
                    </ComboBox.Projection>
                </ComboBox>
                <TextBlock x:Name="TextBlock_6" HorizontalAlignment="Left" Height="Auto" Margin="10,363,0,0" TextWrapping="Wrap" Text="Company:" VerticalAlignment="Top" />
                <ComboBox x:Name="ComboBox7" Margin="0,410,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox7_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_7" HorizontalAlignment="Left" Height="Auto" Margin="10,413,0,0" TextWrapping="Wrap" Text="Model:" VerticalAlignment="Top" />
                <TextBlock x:Name="TextBlock03" FontSize="28" TextAlignment="Center" Text="Storage Device" Margin="0,460,0,0" VerticalAlignment="Top" Foreground="#FF00E5FF"/>
                <ComboBox x:Name="ComboBox8" Margin="0,510,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox8_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_8" HorizontalAlignment="Left" Height="Auto" Margin="10,513,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Type:"/>
                <ComboBox x:Name="ComboBox9" Margin="0,560,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox9_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_9" HorizontalAlignment="Left" Height="Auto" Margin="10,563,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Company:"/>
                <ComboBox x:Name="ComboBox10" Margin="0,610,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox10_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_10" HorizontalAlignment="Left" Height="Auto" Margin="10,613,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Model:"/>
                <TextBlock x:Name="TextBlock04" FontSize="28" TextAlignment="Center" Text="Graphic Card" Margin="0,660,0,0" VerticalAlignment="Top" Foreground="#FF00E5FF"/>
                <ComboBox x:Name="ComboBox11" Margin="0,710,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox11_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_11" HorizontalAlignment="Left" Height="Auto" Margin="10,713,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Type:"/>
                <ComboBox x:Name="ComboBox12" Margin="0,760,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox12_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_12" HorizontalAlignment="Left" Height="Auto" Margin="10,763,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Company:"/>
                <ComboBox x:Name="ComboBox13" Margin="0,810,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox13_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_13" HorizontalAlignment="Left" Height="Auto" Margin="10,813,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Model:"/>
                <Rectangle x:Name="Rectangle1" Fill="#FF00E5FF" Height="2" Margin="40,860,40,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="ComboBox14" Margin="0,880,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox14_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_14" HorizontalAlignment="Left" Height="Auto" Margin="10,883,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Power Supply:"/>
                <ComboBox x:Name="ComboBox15" Margin="0,930,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox15_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_15" HorizontalAlignment="Left" Height="Auto" Margin="10,933,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Case:"/>
                <ComboBox x:Name="ComboBox16" Margin="0,980,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox16_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_16" HorizontalAlignment="Left" Height="Auto" Margin="10,983,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Optical Drive:"/>
                <ComboBox x:Name="ComboBox17" Margin="0,1030,20,-29" VerticalAlignment="Top" SelectionChanged="ComboBox17_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_17" HorizontalAlignment="Left" Height="Auto" Margin="10,1033,0,-22" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Monitor:"/>
                <ComboBox x:Name="ComboBox18" Margin="0,1080,20,-192" VerticalAlignment="Top" SelectionChanged="ComboBox18_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_18" HorizontalAlignment="Left" Height="Auto" Margin="10,1083,0,-185" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Mouse:"/>
                <ComboBox x:Name="ComboBox19" Margin="0,1130,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox19_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock x:Name="TextBlock_19" HorizontalAlignment="Left" Height="Auto" Margin="10,1133,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Text="Keyboard:"/>
                <Button x:Name="Button1" Content="Done"  IsEnabled="False" Click="Button1_Click" HorizontalAlignment="Stretch" Margin="40,1180,40,0" VerticalAlignment="Top" BorderBrush="#FF009CAE" Background="{x:Null}" Foreground="White"/>
            </Grid>
        </ScrollViewer>
        <Page Margin="0,0,0,0" Width="0" Height="0">
            <Page.BottomAppBar>
                <AppBar x:Name="AppBar1" Grid.Row="1" Padding="10,0,10,0" Height="90" VerticalAlignment="Bottom">
                    <GridView Margin="0,0,0,0" IsItemClickEnabled="True" Height="90" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Height="90">
                            <Button x:Name="Button2" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Button2_Click" Style="{StaticResource NewFile}" Height="90" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="90">
                            <Button x:Name="Button3"  HorizontalAlignment="Left" VerticalAlignment="Top"  Click="Button3_Click" Style="{StaticResource SaveAppBarButtonStyle}" Height="90" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="90">
                            <Button x:Name="Button4"  HorizontalAlignment="Left" VerticalAlignment="Top"  Click="Button4_Click" Style="{StaticResource YesAppBarButtonStyle}" Height="90"/>
                        </StackPanel>
                    </GridView>
                </AppBar>
            </Page.BottomAppBar>
        </Page>
        <VisualStateManager.VisualStateGroups>

            <!-- Visual states reflect the application's view state -->
            <VisualStateGroup x:Name="ApplicationViewStates">
                <VisualState x:Name="FullScreenLandscape"/>
                <VisualState x:Name="Filled"/>

                <!-- The entire page respects the narrower 100-pixel margin convention for portrait -->
                <VisualState x:Name="FullScreenPortrait">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PortraitBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- The back button and title have different styles when snapped -->
                <VisualState x:Name="Snapped">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pageTitle" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedPageHeaderTextStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</common:LayoutAwarePage>