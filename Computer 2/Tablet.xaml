<common:LayoutAwarePage
    x:Name="pageRoot"
    x:Class="Computer_2.Tablet"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Computer_2"
    xmlns:common="using:Computer_2.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Background="#FF00A500" Loaded="pageRoot_Loaded">

    <Page.Resources>

        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">My Application</x:String>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid Style="{StaticResource LayoutRootStyle}">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF373737"/>
                <GradientStop Color="#FFC8C8C8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Click="GoBack" IsEnabled="{Binding Frame.CanGoBack, ElementName=pageRoot}" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="pageTitle" Grid.Column="1" Text="Elect Your Tablet" Style="{StaticResource PageHeaderTextStyle}" Foreground="#FF00A500"/>
        </Grid>

        <Grid RenderTransformOrigin="0,0" Grid.Row="1">
            <ListView x:Name="ListView1" Margin="0,65,0,0" SelectionChanged="ListView1_SelectionChanged" HorizontalAlignment="Left" Width="455"/>
            <ComboBox x:Name="ComboBox1" Margin="192,10,0,0" VerticalAlignment="Top" SelectionChanged="ComboBox1_SelectionChanged" HorizontalAlignment="Left" Width="263"/>
            <TextBlock x:Name="TextBlock0" Margin="10,10,0,0" Text="Company:" VerticalAlignment="Top" FontSize="28" HorizontalAlignment="Left" Foreground="#FF00A500"/>
            <ScrollViewer x:Name="ScrollViewer1" Height="628" VerticalAlignment="Top" Margin="475,0,0,0" FontSize="24" HorizontalAlignment="Left" Width="891">
                <Grid>
                    <TextBlock x:Name="TextBlock1" Text="Size: " VerticalAlignment="Top" Margin="10,10,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock2" Text="Weight: " VerticalAlignment="Top" Margin="10,60,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock3" Text="Screen: " VerticalAlignment="Top" Margin="10,110,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock4" Text="OS: " VerticalAlignment="Top" Margin="10,160,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock5" Text="Processor: " VerticalAlignment="Top" Margin="10,210,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TextBlock6" Text="Internal Memory: " VerticalAlignment="Top" Margin="10,260,0,0" HorizontalAlignment="Left"/>
                    <ToggleSwitch x:Name="ToggleSwitch1" Header="Memory Card" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="4,310,0,0"/>
                    <TextBlock x:Name="TextBlock7" Text="Camera: " VerticalAlignment="Top" Margin="10,410,0,0" HorizontalAlignment="Left"/>
                    <ToggleSwitch x:Name="ToggleSwitch2" Header="Flash" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="4,460,0,0"/>
                    <TextBlock x:Name="TextBlock8" HorizontalAlignment="Left" Text="Communication Network Generation: " VerticalAlignment="Top" Margin="10,560,0,0"/>
                    <TextBlock Text="Picture" Margin="10,610,10,0" VerticalAlignment="Top" TextAlignment="Center" />
                    <Image Source="" Width="250" Height="250" Margin="308,660,307,0" VerticalAlignment="Top"/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Page>
            <Page.BottomAppBar>
                <AppBar Grid.Row="1" Padding="10,0,10,0" Height="90" VerticalAlignment="Bottom">
                    <GridView Margin="0,0,0,0" IsItemClickEnabled="True" Height="90" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="90">
                            <Button x:Name="Button1"  HorizontalAlignment="Left" VerticalAlignment="Top"  Click="Button1_Click" Style="{StaticResource SaveAppBarButtonStyle}" Height="90" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="90">
                            <Button x:Name="Button2"  HorizontalAlignment="Left" VerticalAlignment="Top"  Click="Button2_Click" Style="{StaticResource SearchAppBarButtonStyle}" Height="90" />
                        </StackPanel>
                    </GridView>
                </AppBar>
            </Page.BottomAppBar>
        </Page>

        <VisualStateManager.VisualStateGroups>

            <!-- Visual states reflect the application's view state -->
            <VisualStateGroup x:Name="ApplicationViewStates">
                <VisualState x:Name="FullScreenLandscape"/>
                <VisualState x:Name="Filled"/>

                <!-- The entire page respects the narrower 100-pixel margin convention for portrait -->
                <VisualState x:Name="FullScreenPortrait">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PortraitBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- The back button and title have different styles when snapped -->
                <VisualState x:Name="Snapped">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pageTitle" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedPageHeaderTextStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</common:LayoutAwarePage>