  <Identity Name="da4cfe3e-2170-41c0-a00e-d32e172ea77d" Publisher="CN=Mohammad Diab" Version="3.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="1ef82bfb-3863-5226-a121-5dc5c632e1ac" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Computer</DisplayName>
    <PublisherDisplayName>Mohammad Diab</PublisherDisplayName>
