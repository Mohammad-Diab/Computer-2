<?xml version="1.0"?>
<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=unicode" />
        <title>
Tablet Details</title>
        <hta:application id="DeviceDetails" applicationname="Device Details" border="thick" borderstyle="normal" caption="yes" contextmenu="no" maximizebutton="yes" minimizebutton="yes" showintaskbar="yes" singleinstance="yes" sysmenu="yes" version="1.0" />
        <style>
            A:link{text-decoration: none;}
            A:visited{text-decoration: none;}
            A:hover{text-decoration: none;}
            A:active{text-decoration: none;}
            BODY{background-color: #FFFFFF;margin-top: 10px;margin-left: 10px;margin-bottom: 0px;margin-right: 10px;}
            DIV{}
            HR{width: 100%;height: 1px;color: #CCCCCC;margin-top: 5px;margin-left: 0px;direction: ltr;text-align: right;}
            TD{font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;font-size: 9pt;font-weight: normal;line-height: normal;letter-spacing: normal;color: #000000;text-align: left}
            INPUT{font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;font-size: 9pt;font-weight: normal;line-height: normal;letter-spacing: normal;color: #000000;}
            .SubTitle{font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;font-size: 9pt;font-weight: normal;line-height: normal;letter-spacing: normal;color: #1370AB;}
            .SYSLink, .SYSLink:link, .SYSLink:visited{font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;font-size: 9pt;font-weight: normal;line-height: normal;letter-spacing: normal;color: #0000FF;}
            .SYSLink:hover, .SYSLink:active{font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;font-size: 9pt;font-weight: normal;line-height: normal;letter-spacing: normal;color: #3333FF;}
            .title {font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;font-weight: normal;font-size: large;color: #3399FF;background-color: #FFFFFF;text-align: left}
            .subtitle {font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;font-weight: normal;font-size: small;color: #1370AB;background-color: #FFFFFF;text-align: left;width:63px;}
            .normaltext {font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;letter-spacing: normal;outline-color:#000000;line-height: normal;font-weight: normal;font-size: x-small;color: #444444;background-color: #FFFFFF;text-align: left;width: 600px;}
            .overtext {font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;letter-spacing: normal;outline-color: #000000;line-height: normal;font-weight: normal;font-size: x-small;color: #000000;background-color: #FFFFFF;text-align: left;width: 150px;}
            .footer {font-family: Segoe UI, Segoe, Tahoma, Arial, Microsoft Sans Serif;font-weight: normal;font-size: x-small;color: #888888;background-color: #FFFFFF;text-align: center ;width: 700px}
            .auto-style1 {width: 131px;}
        </style>
        <script type="text/javascript" language="javascript">openWindow();
            function openWindow() { var width = 800; var height = 600; var leftVal = (screen.width - width) / 2; var topVal = (screen.height - height) / 2; if (topVal < 0) { topVal = 0; } if (leftVal < 0) { leftVal = 0; } parent.window.moveTo(leftVal, topVal); parent.window.resizeTo(width, height); }
            function ShowPrintDialog() { window.print(); }
        </script>
    </head>

