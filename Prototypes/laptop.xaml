<common:LayoutAwarePage
    x:Name="pageRoot"
    x:Class="Computer_2.laptop"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Computer_2"
    xmlns:common="using:Computer_2.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Loaded="pageRoot_Loaded">

    <Page.Resources>

        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">My Application</x:String>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid Style="{StaticResource LayoutRootStyle}" Background="#FFDC562E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Click="GoBack" IsEnabled="{Binding Frame.CanGoBack, ElementName=pageRoot}" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="pageTitle" Grid.Column="1" Text="Choose your laptop" Style="{StaticResource PageHeaderTextStyle}"/>
        </Grid>
        <Grid RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="1366" Height="628" VerticalAlignment="Top" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ListView x:Name="ListView1" Margin="0,70,0,0" BorderBrush="Black" SelectionChanged="ListView1_SelectionChanged" FontSize="72" HorizontalAlignment="Left" Width="342"/>
                <ComboBox x:Name="ComboBox1" Height="35" Margin="163,12,0,0" VerticalAlignment="Top" SelectionChanged="ComboBox1_SelectionChanged" HorizontalAlignment="Left" Width="179"/>
                <TextBlock Height="41" Margin="10,10,0,0" TextWrapping="Wrap" Text="Company:" VerticalAlignment="Top" FontSize="30" HorizontalAlignment="Left" Width="139"/>
                <ScrollViewer Margin="360,0,0,0" Height="628" VerticalAlignment="Top" HorizontalAlignment="Left" Width="1002" ZoomMode="Disabled">
                    <Grid>
                        <TextBlock x:Name="TextBlock1" Height="28" TextWrapping="Wrap" Text="Processor:" VerticalAlignment="Top" FontSize="24" Margin="10,10,16,0"/>
                        <TextBlock x:Name="TextBlock2" Height="28" TextWrapping="Wrap" Text="Memory:" VerticalAlignment="Top" FontSize="24" Margin="10,60,16,0"/>
                        <TextBlock x:Name="TextBlock3" Height="28" TextWrapping="Wrap" Text="Hard Disk:" VerticalAlignment="Top" FontSize="24" Margin="10,110,16,0"/>
                        <TextBlock x:Name="TextBlock4" Height="28" TextWrapping="Wrap" Text="Graphic Card:" VerticalAlignment="Top" FontSize="24" Margin="10,160,16,0"/>
                        <TextBlock x:Name="TextBlock5" Height="28" TextWrapping="Wrap" Text="Screen:" VerticalAlignment="Top" FontSize="24" Margin="10,210,16,0"/>
                        <TextBlock x:Name="TextBlock6" Height="28" TextWrapping="Wrap" Text="USB Port: " VerticalAlignment="Top" FontSize="24" Margin="10,260,16,0"/>
                        <TextBlock x:Name="TextBlock7" Height="28" TextWrapping="Wrap" Text="Bluetooth: " VerticalAlignment="Top" FontSize="24" Margin="10,310,16,0"/>
                        <TextBlock x:Name="TextBlock8" Height="28" TextWrapping="Wrap" Text="OS: " VerticalAlignment="Top" FontSize="24" Margin="10,360,16,0"/>
                        <TextBlock x:Name="TextBlock9" Height="28" TextWrapping="Wrap" Text="WebCam: " VerticalAlignment="Top" FontSize="24" Margin="10,410,16,0"/>
                        <ToggleSwitch x:Name="ToggleSwitch1" Header="Optical Driver" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="10,460,0,0"/>
                        <ToggleSwitch x:Name="ToggleSwitch2" Header="HDMI Port" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="10,560,0,0"/>
                        <ToggleSwitch x:Name="ToggleSwitch3" Header="VGA Port" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="10,660,0,0"/>
                        <ToggleSwitch x:Name="ToggleSwitch4" Header="Card Reader" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="10,760,0,0"/>
                        <ToggleSwitch x:Name="ToggleSwitch5" Header="Touch Screen" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="10,860,0,0"/>
                        <TextBlock Text="Picture" FontSize="24" IsHitTestVisible="False" Height="28" VerticalAlignment="Top" Margin="10,960,16,0" TextAlignment="Center" />
                        <Image Source="" Width="250" Height="250" Margin="308,1010,308,0" VerticalAlignment="Top"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        <Grid x:Name="Grid1" Grid.RowSpan="2" Visibility="Collapsed">
            <Rectangle HorizontalAlignment="Left" Height="768" VerticalAlignment="Top" Width="1366" Grid.RowSpan="2" Fill="#66000000" Stroke="Black"/>
            <Rectangle x:Name="Rectangle1" Fill="#FF232323" Margin="0,40,0,0" Stroke="Black" HorizontalAlignment="Left" Width="1366" Height="688" VerticalAlignment="Top"/>
            <Grid x:Name="Grid2" Margin="297,40,0,0" HorizontalAlignment="Left" Width="769" Height="688" VerticalAlignment="Top">
                <Button x:Name="Button2" Content="OK" HorizontalAlignment="Right" Height="36" Margin="0,0,125,10" VerticalAlignment="Bottom" Width="100"  Click="Button2_Click"/>
                <Button x:Name="Button3" Content="Cancel" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="100" Height="36" Click="Button3_Click"/>
                <TextBlock x:Name="TextBlock19" FontSize="36" Margin="36,10,0,0" TextAlignment="Justify" TextWrapping="Wrap" Text="Search Results:" Height="45" VerticalAlignment="Top" HorizontalAlignment="Left" Width="273"/>
                <TextBlock x:Name="TextBlock21" HorizontalAlignment="Left" Height="40" Margin="100,62,0,0" TextWrapping="Wrap" Text="Reduce your condition,then try again." VerticalAlignment="Top" Width="495" FontSize="20"/>
                <ListView x:Name="ListView2" Margin="100,100,100,57" FontSize="24"/>
            </Grid>
        </Grid>
    </Grid>

    <VisualStateManager.VisualStateGroups>

        <!-- Visual states reflect the application's view state -->
        <VisualStateGroup x:Name="ApplicationViewStates">
            <VisualState x:Name="FullScreenLandscape"/>
            <VisualState x:Name="Filled"/>

            <!-- The entire page respects the narrower 100-pixel margin convention for portrait -->
            <VisualState x:Name="FullScreenPortrait">
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PortraitBackButtonStyle}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </VisualState>

            <!-- The back button and title have different styles when snapped -->
            <VisualState x:Name="Snapped">
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedBackButtonStyle}"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pageTitle" Storyboard.TargetProperty="Style">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedPageHeaderTextStyle}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</common:LayoutAwarePage>
