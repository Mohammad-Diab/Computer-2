<common:LayoutAwarePage
    x:Name="pageRoot"
    x:Class="Computer_2.desktop"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Computer_2"
    xmlns:common="using:Computer_2.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Loaded="pageRoot_Loaded">

    <Page.Resources>

        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">My Application</x:String>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid Style="{StaticResource LayoutRootStyle}" Background="#FF009DAE">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Click="GoBack" IsEnabled="{Binding Frame.CanGoBack, ElementName=pageRoot}" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="pageTitle" Grid.Column="1" Text="Select Your PC Pieces" Style="{StaticResource PageHeaderTextStyle}"/>
        </Grid>
        
        <ListView HorizontalAlignment="Left" Height="628" Margin="481,0,0,0" Grid.Row="1" VerticalAlignment="Top" Width="885" IsItemClickEnabled="True" IsHitTestVisible="False">
            <TextBlock x:Name="TextBlock1" HorizontalAlignment="Left" Height="Auto" TextWrapping="Wrap" Text="Processor:" VerticalAlignment="Top" Width="881" FontSize="24"/>
            <Grid HorizontalAlignment="Left" Height="91" VerticalAlignment="Top" Width="464">
                <ToggleSwitch x:Name="ToggleSwitch3" Header="Can Increase CPU Speed (not Over Clocking)" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No" Margin="0,0,-30,0" Width="494"/>
                <TextBlock x:Name="TextBlock6" HorizontalAlignment="Left" Height="28" Margin="169,51,0,0" TextWrapping="Wrap" Text="Up To:" VerticalAlignment="Top" Width="293" FontSize="22"/>
            </Grid>
            <ToggleSwitch x:Name="ToggleSwitch2" Header="Virtualization Technology" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No"/>
            <TextBlock x:Name="TextBlock2" HorizontalAlignment="Left" TextWrapping="Wrap" Text="MotherBoard:" VerticalAlignment="Top" Width="881" FontSize="24"/>
            <TextBlock x:Name="TextBlock3" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Graphic Card:" VerticalAlignment="Top" Width="881" FontSize="24"/>
            <ToggleSwitch x:Name="ToggleSwitch1" Header="Can Add More GPU (CrossFireX or SLI)" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" IsHitTestVisible="False" OnContent="Yes" OffContent="No"/>
            <TextBlock x:Name="TextBlock5" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Hard Disk:" VerticalAlignment="Top" Width="891" FontSize="24"/>
            <TextBlock x:Name="TextBlock4" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Memory:" VerticalAlignment="Top" Width="881" FontSize="24"/>
        </ListView>
        <ScrollViewer x:Name="ScrollViewer1" HorizontalAlignment="Left" Grid.Row="1" Width="475" Background="{x:Null}" FontSize="24">
            <Grid HorizontalAlignment="Left" Height="1250" VerticalAlignment="Top" Width="470">
                <TextBlock FontSize="28" TextAlignment="Center" Text="Motherboard and Processor" Height="35" Margin="0,10,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="ComboBox1" Height="35" Margin="0,60,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox1_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263">
                    <ComboBoxItem Content="AMD"/>
                    <ComboBoxItem Content="Intel"/>
                </ComboBox>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,63,0,0" TextWrapping="Wrap" Text="PC Kind:" VerticalAlignment="Top" Width="172"/>
                <ComboBox x:Name="ComboBox2" Height="35" Margin="0,110,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox2_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,113,0,0" TextWrapping="Wrap" Text="MB Company:" VerticalAlignment="Top" Width="172" />
                <ComboBox x:Name="ComboBox3" Height="35" Margin="0,160,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox3_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,163,0,0" TextWrapping="Wrap" Text="Motherboard:" VerticalAlignment="Top" Width="172" />
                <ComboBox x:Name="ComboBox4" Height="35" Margin="0,210,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox4_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,213,0,0" TextWrapping="Wrap" Text="CPU Model:" VerticalAlignment="Top" Width="172" />
                <ComboBox x:Name="ComboBox5" Height="35" Margin="0,260,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox5_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,263,0,0" TextWrapping="Wrap" Text="Processor:" VerticalAlignment="Top" Width="172" />
                <TextBlock FontSize="28" TextAlignment="Center" Text="Random Access Memory (RAM)" Height="35" Margin="0,310,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="ComboBox6" Height="35" Margin="0,360,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox6_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,363,0,0" TextWrapping="Wrap" Text="Company:" VerticalAlignment="Top" Width="172" />
                <ComboBox x:Name="ComboBox7" Height="35" Margin="0,410,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox7_SelectionChanged" IsEnabled="False" HorizontalAlignment="Right" Width="263"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,414,0,0" TextWrapping="Wrap" Text="Model:" VerticalAlignment="Top" Width="172" />
                <TextBlock FontSize="28" TextAlignment="Center" Text="Storage Device" Width="460" Height="35" Margin="0,460,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="ComboBox8" Height="35" Margin="0,510,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox8_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,513,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Type:"/>
                <ComboBox x:Name="ComboBox9" Height="35" Margin="0,560,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox9_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,563,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Company:"/>
                <ComboBox x:Name="ComboBox10" Height="35" Margin="0,610,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox10_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,613,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Model:"/>
                <TextBlock FontSize="28" TextAlignment="Center" Text="Graphic Card" Width="460" Height="35" Margin="0,660,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="ComboBox11" Height="35" Margin="0,710,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox11_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,713,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Type:"/>
                <ComboBox x:Name="ComboBox12" Height="35" Margin="0,760,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox12_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,763,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Company:"/>
                <ComboBox x:Name="ComboBox13" Height="35" Margin="0,810,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox13_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,813,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Model:"/>
                <Rectangle Fill="White" Height="2" Margin="40,860,40,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="ComboBox14" Height="35" Margin="0,880,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox14_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,883,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Power Supply:"/>
                <ComboBox x:Name="ComboBox15" Height="35" Margin="0,930,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox15_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,933,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Case:"/>
                <ComboBox x:Name="ComboBox16" Height="35" Margin="0,980,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox16_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,983,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Optical Drive:"/>
                <ComboBox x:Name="ComboBox17" Height="35" Margin="0,1030,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox17_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,1033,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Monitor:"/>
                <ComboBox x:Name="ComboBox18" Height="35" Margin="0,1080,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox18_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,1083,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Mouse:"/>
                <ComboBox x:Name="ComboBox19" Height="35" Margin="0,1130,20,0" VerticalAlignment="Top" SelectionChanged="ComboBox19_SelectionChanged" HorizontalAlignment="Right" Width="263" IsEnabled="False"/>
                <TextBlock HorizontalAlignment="Left" Height="Auto" Margin="10,1133,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="172"  Text="Keyboard:"/>
                <Button x:Name="Button1" Content="Done"  IsEnabled="False" Click="Button1_Click" HorizontalAlignment="Stretch" Margin="40,1180,40,0" VerticalAlignment="Top" Height="60"/>
            </Grid>
        </ScrollViewer>
        <Page>
            <Page.BottomAppBar>
                <AppBar Grid.Row="1" Padding="10,0,10,0" Height="90" VerticalAlignment="Bottom">
                    <GridView Margin="0,0,0,0" IsItemClickEnabled="True" Height="90" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Height="90">
                            <Button x:Name="Button2" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Button2_Click" Style="{StaticResource NewFile}" Height="90" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="90">
                            <Button x:Name="Button3"  HorizontalAlignment="Left" VerticalAlignment="Top"  Click="Button3_Click" Style="{StaticResource SaveAppBarButtonStyle}" Height="90" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="90">
                            <Button x:Name="Button4"  HorizontalAlignment="Left" VerticalAlignment="Top"  Click="Button5_Click" Style="{StaticResource YesAppBarButtonStyle}" Height="90" />
                        </StackPanel>
                    </GridView>
        </AppBar>
            </Page.BottomAppBar>
        </Page>
        <VisualStateManager.VisualStateGroups>

            <!-- Visual states reflect the application's view state -->
            <VisualStateGroup x:Name="ApplicationViewStates">
                <VisualState x:Name="FullScreenLandscape"/>
                <VisualState x:Name="Filled"/>

                <!-- The entire page respects the narrower 100-pixel margin convention for portrait -->
                <VisualState x:Name="FullScreenPortrait">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PortraitBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- The back button and title have different styles when snapped -->
                <VisualState x:Name="Snapped">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pageTitle" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedPageHeaderTextStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</common:LayoutAwarePage>
